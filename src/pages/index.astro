---
import { getCollection } from 'astro:content';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PackageCard from '../components/PackageCard.astro';
import DestinationCard from '../components/DestinationCard.astro';
import BlogCard from '../components/BlogCard.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import FAQList from '../components/FAQList.astro';
import Icon from '../components/Icon.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { site } from '../data/site';
import { gallery } from '../data/gallery';
import { testimonials } from '../data/testimonials';
import { sortByDateDesc } from '../lib/utils';

const paket = (await getCollection('paket', ({ data }) => data.published)).sort((a, b) => Number(b.data.featured) - Number(a.data.featured)).slice(0, 3);
const wisata = (await getCollection('wisata', ({ data }) => data.published)).sort((a, b) => Number(b.data.featured) - Number(a.data.featured)).slice(0, 3);
const blog = sortByDateDesc(await getCollection('blog', ({ data }) => data.published)).slice(0, 3);

const heroDesc = `Temukan pilihan kegiatan outbound, team building, dan gathering yang dapat disesuaikan dengan tujuan acara serta kebutuhan peserta${site.serviceArea ? ` di ${site.serviceArea}` : ''}.`;

const faqs = [
  { q: 'Apa perbedaan outbound, team building, dan gathering?', a: 'Outbound adalah kegiatan luar ruang yang memakai aktivitas fisik dan permainan sebagai medium belajar. Team building adalah kegiatan yang tujuannya melatih kerja sama dan komunikasi tim, sering memakai format outbound. Gathering adalah acara berkumpul untuk mempererat hubungan, biasanya lebih santai dan tidak selalu berisi permainan terstruktur.' },
  { q: 'Bagaimana cara meminta penawaran paket?', a: 'Pilih paket yang diminati lalu tekan tombol konsultasi. Sampaikan tujuan acara, perkiraan jumlah peserta, dan tanggal yang diinginkan agar tim dapat menyesuaikan penawaran.' },
  { q: 'Apakah harga paket sudah pasti?', a: 'Harga bergantung pada jumlah peserta, pilihan aktivitas, lokasi, dan tanggal pelaksanaan. Karena itu informasi harga disampaikan melalui penawaran setelah kebutuhan acara dikonfirmasi.' },
  { q: 'Berapa jumlah peserta minimal untuk mengadakan kegiatan?', a: 'Umumnya program kelompok efektif dimulai dari 20–25 peserta hingga ratusan peserta untuk skala family gathering. Jika jumlah peserta di bawah itu, tim kami tetap dapat membantu menyesuaikan format kegiatannya.' },
  { q: 'Apakah lokasi kegiatan bisa ditentukan oleh pihak panitia atau perusahaan?', a: 'Bisa. Anda dapat memilih salah satu lokasi mitra di Kota Batu, Pujon, atau Kasembon, maupun meminta tim kami menyelenggarakan program outbound di hotel, resort, atau villa pilihan panitia Anda.' },
];

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: Astro.site!.href,
  logo: new URL(site.logo, Astro.site).href,
  description: site.description,
  ...(site.email ? { email: site.email } : {}),
  ...(site.whatsapp ? { telephone: `+${site.whatsapp}` } : {}),
  ...(Object.values(site.social).some(Boolean) ? { sameAs: Object.values(site.social).filter(Boolean) } : {}),
};
const webLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: Astro.site!.href, inLanguage: 'id-ID' };

const highlights = [
  {
    icon: 'compass',
    title: 'Program Terarah & Fleksibel',
    desc: 'Aktivitas disesuaikan dengan tujuan kegiatan dan profil peserta',
  },
  {
    icon: 'check',
    title: 'Rincian Paket Transparan',
    desc: 'Informasi durasi, fasilitas, dan alur dijelaskan sejak awal',
  },
  {
    icon: 'shield',
    title: 'Prosedur & Keselamatan Jelas',
    desc: 'Peralatan terstandar, briefing keamanan, dan tim pendamping lapangan',
  },
  {
    icon: 'camera',
    title: 'Dokumentasi Terorganisir',
    desc: 'Dokumentasi kegiatan tersedia sebagai referensi dan kenangan tim',
  },
];

const steps = [
  {
    num: '01',
    title: 'Konsultasi Kebutuhan',
    desc: 'Sampaikan tujuan acara, profil peserta, perkiraan jumlah rombongan, dan rencana tanggal pelaksanaan.',
  },
  {
    num: '02',
    title: 'Penyesuaian Paket & Lokasi',
    desc: 'Tim kami menyusun rekomendasi materi permainan, opsi venue di Batu–Malang, serta susunan rundown acara.',
  },
  {
    num: '03',
    title: 'Konfirmasi & Kesepakatan',
    desc: 'Rincian fasilitas, konsumsi, perlengkapan, serta penawaran anggaran dikonfirmasi secara transparan bersama panitia.',
  },
  {
    num: '04',
    title: 'Pelaksanaan di Lapangan',
    desc: 'Mulai dari safety briefing, pemanduan games, refleksi tim, hingga dokumentasi berjalan rapi sesuai kesepakatan.',
  },
];
---
<MarketingLayout
  title={`Outbound, Team Building, dan Gathering${site.serviceArea ? ` di ${site.serviceArea}` : ''} — ${site.name}`}
  description={site.description}
  jsonLd={[orgLd, webLd]}
>
  <Hero
    label="OUTBOUND • TEAM BUILDING • GATHERING"
    title="Bangun Kebersamaan Lewat Petualangan di Alam Terbuka"
    description={heroDesc}
    image="/images/hero/hero-outbound-malang.webp"
    imageAlt="Kegiatan outbound dan team building di alam terbuka Batu Malang"
    primary={{ label: 'Lihat Paket Outbound', href: '/paket/' }}
    secondary="whatsapp"
    waMessage="Halo, saya ingin berkonsultasi tentang kegiatan outbound."
  />

  <section class="trust" aria-label="Keunggulan layanan">
    <div class="container">
      <ul class="trust__grid">
        {highlights.map((h) => (
          <li class="trust__item">
            <div class="trust__icon-wrap"><Icon name={h.icon} /></div>
            <div class="trust__body">
              <strong>{h.title}</strong>
              <span>{h.desc}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Layanan Utama"
        title="Kegiatan untuk berbagai tujuan acara"
        description="Pilih arah kegiatan sesuai kebutuhan instansi, komunitas, atau keluarga Anda, lalu sesuaikan aktivitas bersama tim kami."
        href="/paket/"
        linkLabel="Bandingkan paket"
      />
      <div class="features features--4">
        <a href="/paket/outbound-team-building/" class="feature">
          <div class="feature__top">
            <div class="feature__icon"><Icon name="users" /></div>
            <span class="feature__num">01</span>
          </div>
          <h3>Team Building</h3>
          <p>Melatih komunikasi efektif, kepemimpinan, dan koordinasi kerja tim lewat simulasi permainan kelompok terarah.</p>
          <div class="feature__foot">
            <span class="feature__tag">Corporate & Instansi</span>
            <span class="feature__more">Detail <Icon name="arrow-right" class="feature__arrow" /></span>
          </div>
        </a>
        <a href="/paket/fun-outbound/" class="feature">
          <div class="feature__top">
            <div class="feature__icon"><Icon name="flag" /></div>
            <span class="feature__num">02</span>
          </div>
          <h3>Fun Outbound</h3>
          <p>Permainan luar ruang yang seru, ringan, dan interaktif untuk mencairkan suasana keluarga, komunitas, atau sekolah.</p>
          <div class="feature__foot">
            <span class="feature__tag">Keluarga & Komunitas</span>
            <span class="feature__more">Detail <Icon name="arrow-right" class="feature__arrow" /></span>
          </div>
        </a>
        <a href="/paket/corporate-family-gathering/" class="feature">
          <div class="feature__top">
            <div class="feature__icon"><Icon name="heart" /></div>
            <span class="feature__num">03</span>
          </div>
          <h3>Family Gathering</h3>
          <p>Acara kebersamaan lintas usia yang dikemas hangat dengan fun games, hiburan, dan jamuan di alam terbuka.</p>
          <div class="feature__foot">
            <span class="feature__tag">Karyawan & Keluarga</span>
            <span class="feature__more">Detail <Icon name="arrow-right" class="feature__arrow" /></span>
          </div>
        </a>
        <a href="/wisata/" class="feature">
          <div class="feature__top">
            <div class="feature__icon"><Icon name="compass" /></div>
            <span class="feature__num">04</span>
          </div>
          <h3>Wisata & Adventure</h3>
          <p>Eksplorasi lokasi outbound hutan pinus, arung jeram sungai alami, dan kawasan wisata pegunungan berfasilitas lengkap.</p>
          <div class="feature__foot">
            <span class="feature__tag">Batu, Pujon & Kasembon</span>
            <span class="feature__more">Detail <Icon name="arrow-right" class="feature__arrow" /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeading
        eyebrow="Pilihan Paket"
        title="Paket outbound dan gathering pilihan"
        description="Setiap paket memuat rincian durasi, rentang peserta, cakupan fasilitas, serta contoh susunan acara yang dapat disesuaikan."
        href="/paket/"
        linkLabel="Lihat semua paket"
      />
      {paket.length ? (
        <div class="grid grid--cards">{paket.map((e) => <PackageCard entry={e} />)}</div>
      ) : (
        <div class="empty"><h3>Paket segera hadir</h3><p>Daftar paket sedang disiapkan. Hubungi kami untuk konsultasi kebutuhan acara.</p></div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Destinasi & Venue"
        title="Lokasi kegiatan dan wisata alam"
        description="Kenali karakteristik area, aktivitas unggulan, fasilitas pendukung, dan akses menuju lokasi sebelum menentukan tempat acara."
        href="/wisata/"
        linkLabel="Lihat semua lokasi"
      />
      {wisata.length ? (
        <div class="grid grid--cards">{wisata.map((e) => <DestinationCard entry={e} />)}</div>
      ) : (
        <div class="empty"><h3>Destinasi segera hadir</h3><p>Informasi lokasi sedang diverifikasi.</p></div>
      )}
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <SectionHeading
        eyebrow="Alur Layanan"
        title="Dari konsultasi sampai hari pelaksanaan"
        description="Proses perencanaan dibuat jelas dan bertahap agar panitia memperoleh gambaran kegiatan yang pasti sejak awal."
      />
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <div class="steps__head">
              <span class="steps__badge">Langkah {s.num}</span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </li>
        ))}
      </ol>
      <div class="steps__foot">
        <p>Butuh proposal atau estimasi anggaran untuk pengajuan internal kantor?</p>
        <WhatsAppCTA
          variant="light"
          size="sm"
          label="Diskusikan Kebutuhan Acara"
          message="Halo, saya ingin mendiskusikan rencana kegiatan outbound dan meminta estimasi penawaran."
        />
      </div>
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHeading
          eyebrow="Dokumentasi Nyata"
          title="Cuplikan kegiatan di lapangan"
          description="Referensi suasana kegiatan ice breaking, team building, petualangan high rope, hingga arung jeram bersama peserta."
          href="/galeri/"
          linkLabel="Buka galeri lengkap"
        />
        <GalleryGrid items={gallery} limit={6} />
      </div>
    </section>
  )}

  {testimonials.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <SectionHeading
          eyebrow="Testimoni Klien"
          title="Pengalaman panitia dan peserta kegiatan"
          description="Kesan dari koordinator acara, tim HR, dan perwakilan instansi yang telah menyelenggarakan kegiatan bersama kami."
        />
        <div class="quotes">
          {testimonials.map((t) => (
            <figure class="quote">
              <div class="quote__top">
                {t.tag && <span class="quote__tag">{t.tag}</span>}
                <span class="quote__stars" aria-label="Penilaian 5 dari 5 bintang">★★★★★</span>
              </div>
              <blockquote><p>“{t.quote}”</p></blockquote>
              <figcaption>
                {t.avatar ? (
                  <img
                    class="quote__avatar"
                    src={t.avatar}
                    alt={t.name}
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="quote__avatar" aria-hidden="true">{t.name.charAt(0)}</span>
                )}
                <div>
                  <strong>{t.name}</strong>
                  <span>{t.role}</span>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {blog.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHeading
          eyebrow="Wawasan & Panduan"
          title="Artikel dan tips perencanaan outbound"
          description="Panduan praktis memilih paket kegiatan, menyiapkan perlengkapan peserta, dan menyusun acara luar ruang yang efektif."
          href="/blog/"
          linkLabel="Baca semua artikel"
        />
        <div class="grid grid--cards">{blog.map((e) => <BlogCard entry={e} />)}</div>
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="container">
      <div class="home-faq">
        <div class="home-faq__intro">
          <span class="eyebrow">Tanya Jawab (FAQ)</span>
          <h2>Pertanyaan yang sering diajukan</h2>
          <p class="home-faq__lead">Temukan penjelasan singkat seputar perbedaan program, mekanisme penawaran harga, hingga pemilihan lokasi kegiatan.</p>
          <div class="home-faq__card">
            <h3>Punya pertanyaan khusus tentang acara Anda?</h3>
            <p>Tim kami siap membantu memberikan saran program dan opsi lokasi yang paling sesuai dengan jumlah peserta Anda.</p>
            <WhatsAppCTA
              variant="primary"
              size="sm"
              label="Tanya Tim Kami"
              message="Halo, saya ingin bertanya lebih lanjut mengenai rencana kegiatan outbound."
            />
          </div>
        </div>
        <div class="home-faq__list">
          <FAQList items={faqs} idPrefix="home-faq" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <div class="cta-band__content">
          <span class="cta-band__eyebrow"><Icon name="leaf" size={14} /> KONSULTASI & PENAWARAN</span>
          <h2>Siap merencanakan kegiatan Anda?</h2>
          <p>Ceritakan tujuan acara, rencana tanggal, dan perkiraan jumlah peserta. Kami bantu menyusun opsi paket serta lokasi yang paling tepat.</p>
          <ul class="cta-band__points">
            <li><Icon name="check" size={16} /> Susunan acara fleksibel</li>
            <li><Icon name="check" size={16} /> Rincian fasilitas transparan</li>
            <li><Icon name="check" size={16} /> Pendampingan fasilitator berpengalaman</li>
          </ul>
        </div>
        <div class="cta-band__actions">
          <WhatsAppCTA variant="light" size="lg" message="Halo, saya ingin meminta penawaran kegiatan outbound." label="Konsultasi Sekarang" />
          <a href="/paket/" class="btn btn--ghost-light btn--lg">Lihat Pilihan Paket</a>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
