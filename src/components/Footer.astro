---
import { navigation } from '../data/navigation';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

// Hanya paket aktif dari website
const paket = (await getCollection('paket', ({ data }) => data.published)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title, 'id')
);

const social = Object.entries(site.social).filter(([, v]) => v);
const label: Record<string, string> = { instagram: 'Instagram', tiktok: 'TikTok', facebook: 'Facebook', youtube: 'YouTube' };

const whatsappFormatted = site.whatsapp
  ? (site.whatsapp.startsWith('62')
      ? '+62 ' + site.whatsapp.slice(2).replace(/(\d{3})(\d{4})(\d+)/, '$1-$2-$3')
      : `+${site.whatsapp}`)
  : '';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__grid">
      <!-- Kolom 1: Profil Brand & Medsos -->
      <div>
        <a class="brand footer__brand" href="/" style="color:#fff">
          <img src={site.logo} alt="" width="38" height="38" />
          <span>{site.name}</span>
        </a>
        <p style="max-width:340px;line-height:1.6;color:rgb(255 255 255 / .8)">
          {site.description}
        </p>
        {social.length > 0 && (
          <ul class="footer__social-list">
            {social.map(([k, v]) => (
              <li>
                <a href={v} rel="noopener noreferrer me" target="_blank">
                  {label[k]}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Kolom 2: Navigasi Website -->
      <div>
        <h2>Navigasi</h2>
        <ul>
          {navigation.map((n) => (
            <li>
              <a href={n.href}>{n.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Kolom 3: Paket Unggulan Resmi -->
      <div>
        <h2>Paket unggulan</h2>
        <ul>
          {paket.map((p) => (
            <li>
              <a href={`/paket/${p.id}/`}>{p.data.title}</a>
            </li>
          ))}
          <li>
            <a href="/paket/" style="color:var(--color-leaf-300);font-weight:600">Semua paket &rarr;</a>
          </li>
        </ul>
      </div>

      <!-- Kolom 4: Kontak Lengkap & Profesional -->
      <div id="kontak-footer">
        <h2>Kontak</h2>
        <address class="footer__contact">
          {site.serviceArea && (
            <div class="footer__contact-line">
              <Icon name="compass" size={16} class="footer__contact-ico" />
              <span>Area layanan: {site.serviceArea}</span>
            </div>
          )}
          {site.address && (
            <div class="footer__contact-line">
              <Icon name="pin" size={16} class="footer__contact-ico" />
              <span>{site.address}</span>
            </div>
          )}
          {site.whatsapp && (
            <div class="footer__contact-line">
              <Icon name="whatsapp" size={16} class="footer__contact-ico" />
              <a href={`https://wa.me/${site.whatsapp}`} rel="noopener noreferrer" target="_blank">
                WhatsApp: {whatsappFormatted || `+${site.whatsapp}`}
              </a>
            </div>
          )}
          {site.email && (
            <div class="footer__contact-line">
              <Icon name="mail" size={16} class="footer__contact-ico" />
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </div>
          )}
          {site.hours && (
            <div class="footer__contact-line">
              <Icon name="clock" size={16} class="footer__contact-ico" />
              <span>Jam layanan: {site.hours}</span>
            </div>
          )}
          {!site.whatsapp && !site.email && !site.address && (
            <span>Informasi kontak akan segera tersedia.</span>
          )}
        </address>

        {site.whatsapp && (
          <div style="margin-top:16px">
            <a
              href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Halo, saya ingin bertanya tentang kegiatan outbound.')}`}
              class="btn btn--primary btn--sm"
              target="_blank"
              rel="noopener noreferrer"
              style="display:inline-flex;align-items:center;gap:8px;text-decoration:none"
            >
              <Icon name="whatsapp" size={16} />
              <span>Hubungi Kami</span>
            </a>
          </div>
        )}
      </div>
    </div>

    <!-- Bottom Footer -->
    <div class="footer__bottom">
      <span>&copy; {new Date().getFullYear()} {site.name}. Seluruh hak cipta dilindungi.</span>
      <div class="footer__bottom-links">
        <a href="/tentang-kami/">Tentang Kami</a>
        <span aria-hidden="true">&bull;</span>
        <a href="/paket/">Paket</a>
        <span aria-hidden="true">&bull;</span>
        <a href="/tentang-kami/#kontak">Kontak</a>
      </div>
    </div>
  </div>
</footer>
