---
import Icon from './Icon.astro';
import { site, hasWhatsApp } from '../data/site';
import { waLink } from '../lib/utils';

interface Props {
  waMessage?: string;
}

const { waMessage = 'Halo, saya ingin bertanya tentang kegiatan outbound.' } = Astro.props;
const wa = waLink(waMessage);
const href = wa ?? (site.email ? `mailto:${site.email}?subject=${encodeURIComponent('Konsultasi kegiatan')}&body=${encodeURIComponent(waMessage)}` : '/tentang-kami/#kontak');
const isExternal = hasWhatsApp;
---

<div class="floating-actions" id="floating-actions" aria-label="Aksi Cepat">
  <!-- Tombol Back to Top -->
  <button
    type="button"
    class="floating-btn floating-btn--top"
    id="back-to-top"
    aria-label="Kembali ke atas halaman"
    title="Kembali ke atas"
    tabindex="-1"
    aria-hidden="true"
  >
    <Icon name="arrow-up" size={22} class="floating-icon" />
    <span class="floating-tooltip" role="tooltip">Ke Atas</span>
  </button>

  <!-- Tombol WhatsApp Mengambang (Bulat) -->
  <a
    href={href}
    class="floating-btn floating-btn--wa"
    id="wa-float-btn"
    aria-label="Hubungi kami melalui WhatsApp"
    title="Chat WhatsApp"
    {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    data-cta="whatsapp-float"
  >
    <span class="floating-pulse" aria-hidden="true"></span>
    <svg class="floating-icon floating-icon--wa" viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>
    <span class="sr-only">Hubungi via WhatsApp (membuka di tab baru)</span>
    <span class="floating-tooltip" role="tooltip">Chat WhatsApp</span>
  </a>
</div>

<script>
  const backToTop = document.getElementById('back-to-top');
  if (backToTop) {
    let isVisible = false;
    let ticking = false;

    const checkScroll = () => {
      const shouldShow = window.scrollY > 280;
      if (shouldShow !== isVisible) {
        isVisible = shouldShow;
        backToTop.classList.toggle('is-visible', isVisible);
        backToTop.setAttribute('tabindex', isVisible ? '0' : '-1');
        backToTop.setAttribute('aria-hidden', isVisible ? 'false' : 'true');
      }
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(checkScroll);
        ticking = true;
      }
    }, { passive: true });

    // Initial check
    checkScroll();

    backToTop.addEventListener('click', () => {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({
        top: 0,
        behavior: prefersReduced ? 'auto' : 'smooth'
      });
      const main = document.getElementById('konten');
      if (main) {
        main.focus({ preventScroll: true });
      }
    });
  }
</script>

