---
interface Item { label: string; href?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.label,
    item: new URL(it.href ?? Astro.url.pathname, Astro.site).href,
  })),
};
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((it, i) => (
      <li>
        {i < items.length - 1 && it.href ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
